// ---------- web handlers ----------
bool isAuthed() {
  if (sessionToken.length() == 0) return false;
  String c = server.header("Cookie");
  return c.indexOf("sid=" + sessionToken) >= 0;
}

bool requireAuth() {
  if (isAuthed()) return true;
  server.send(401, "application/json", "{\"error\":\"login required\"}");
  return false;
}

String jsonEscape(const String& s) {
  String o = "";
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"' || c == '\\') { o += '\\'; o += c; }
    else if (c == '\n' || c == '\r') o += ' ';
    else o += c;
  }
  return o;
}

String csvEscape(const String& s) {
  String o = "\"";
  for (size_t i = 0; i < s.length(); i++) {
    if (s[i] == '"') o += "\"\"";
    else o += s[i];
  }
  return o + "\"";
}

void handleRoot() {
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleLogin() {
  if (server.arg("user") == PROF_USER && server.arg("pass") == PROF_PASS) {
    sessionToken = String((uint32_t)esp_random(), HEX) + String((uint32_t)esp_random(), HEX);
    server.sendHeader("Set-Cookie", "sid=" + sessionToken + "; Path=/; HttpOnly");
    server.send(200, "application/json", "{\"ok\":true}");
  } else {
    delay(600);  // slows down password guessing
    server.send(403, "application/json", "{\"ok\":false}");
  }
}

void handleLogout() {
  sessionToken = "";
  server.sendHeader("Set-Cookie", "sid=; Path=/; Max-Age=0");
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleStudents() {
  if (!requireAuth()) return;
  int present = 0;
  String j = "{\"students\":[";
  for (size_t i = 0; i < students.size(); i++) {
    if (i) j += ",";
    if (students[i].present) present++;
    j += "{\"code\":\"" + jsonEscape(students[i].code) + "\",";
    j += "\"name\":\"" + jsonEscape(students[i].name) + "\",";
    j += String("\"present\":") + (students[i].present ? "true" : "false") + ",";
    j += "\"time\":\"" + jsonEscape(students[i].markedAt) + "\",";
    j += "\"device\":\"" + jsonEscape(students[i].device) + "\"}";
  }
  j += "],\"total\":" + String(students.size()) + ",\"present\":" + String(present) + "}";
  server.send(200, "application/json", j);
}

void handleAdd() {
  if (!requireAuth()) return;
  String code = cleanCode(server.arg("code"));
  String name = cleanName(server.arg("name"));
  if (code.length() == 0 || name.length() == 0) {
    server.send(200, "application/json", "{\"ok\":false,\"error\":\"Code and name are required (code: letters/numbers only)\"}");
    return;
  }
  if (code == "HELP") {
    server.send(200, "application/json", "{\"ok\":false,\"error\":\"HELP is a reserved code\"}");
    return;
  }
  if (findByCode(code) >= 0) {
    server.send(200, "application/json", "{\"ok\":false,\"error\":\"That code already exists\"}");
    return;
  }
  if ((int)students.size() >= MAX_STUDENTS) {
    server.send(200, "application/json", "{\"ok\":false,\"error\":\"Student limit reached\"}");
    return;
  }
  students.push_back({code, name, false, "", ""});
  saveData();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleDelete() {
  if (!requireAuth()) return;
  int idx = findByCode(cleanCode(server.arg("code")));
  if (idx >= 0) {
    students.erase(students.begin() + idx);
    saveData();
  }
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleMark() {
  if (!requireAuth()) return;
  int idx = findByCode(cleanCode(server.arg("code")));
  if (idx >= 0) {
    bool p = server.arg("present") == "1";
    students[idx].present = p;
    students[idx].markedAt = p ? nowText() + " (manual)" : "";
    students[idx].device = "";   // marking absent frees that phone to be used again
    saveData();
  }
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleReset() {
  if (!requireAuth()) return;
  resetAll();
  server.send(200, "application/json", "{\"ok\":true}");
}

void handleDownload() {
  if (!requireAuth()) return;
  String csv = "Code,Name,Status,Marked At,Phone\r\n";
  for (auto& s : students) {
    csv += csvEscape(s.code) + "," + csvEscape(s.name) + "," +
           (s.present ? "Present" : "Absent") + "," + csvEscape(s.markedAt) + "," +
           csvEscape(s.device) + "\r\n";
  }
  server.sendHeader("Content-Disposition", "attachment; filename=\"attendance.csv\"");
  server.send(200, "text/csv", csv);
}

void setupWeb() {
  const char* keys[] = {"Cookie"};
  server.collectHeaders(keys, 1);

  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/login", HTTP_POST, handleLogin);
  server.on("/api/logout", HTTP_POST, handleLogout);
  server.on("/api/students", HTTP_GET, handleStudents);
  server.on("/api/add", HTTP_POST, handleAdd);
  server.on("/api/delete", HTTP_POST, handleDelete);
  server.on("/api/mark", HTTP_POST, handleMark);
  server.on("/api/reset", HTTP_POST, handleReset);
  server.on("/api/download", HTTP_GET, handleDownload);
  server.onNotFound([]() { server.send(404, "text/plain", "Not found"); });
  server.begin();
}

// ---------- setup / loop ----------
void setup() {
  Serial.begin(115200);
  delay(500);

  prefs.begin("attend", false);
  loadData();

#if DEVICE_LOCK
  SerialBT.register_callback(btEvent);   // lets us see which phone connected
#endif
  bool ok = static_cast<bool>(SerialBT.begin(BT_NAME));
  if (!ok) {
    Serial.println("ERROR: Bluetooth failed to start.");
    Serial.println("Check that the board is an original ESP32 and that");
    Serial.println("Tools > Board is set to ESP32 Dev Module.");
    while (true) delay(1000);
  }

  Serial.println("Bluetooth started OK.");
  Serial.printf("Bluetooth name: %s\n", BT_NAME);

  const uint8_t* mac = esp_bt_dev_get_address();
  if (mac) {
    Serial.printf("Bluetooth address: %02X:%02X:%02X:%02X:%02X:%02X\n",
                  mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
  }

  // Wi-Fi: own hotspot + (optional) router
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);
  Serial.printf("Dashboard Wi-Fi: %s  (password: %s)\n", AP_SSID, AP_PASS);
  Serial.printf("Dashboard URL:   http://%s\n", WiFi.softAPIP().toString().c_str());

  if (strlen(STA_SSID) > 0) {
    WiFi.begin(STA_SSID, STA_PASS);
    unsigned long t0 = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t0 < 8000) delay(250);
    if (WiFi.status() == WL_CONNECTED) {
      Serial.printf("Router URL:      http://%s\n", WiFi.localIP().toString().c_str());
      configTime(TZ_OFFSET_SEC, 0, "pool.ntp.org", "time.nist.gov");
    } else {
      Serial.println("Router connection failed (hotspot still works).");
    }
  }

  setupWeb();

  Serial.println("Phones: connect to Attendance-ESP32 and send your code.");
  Serial.println("USB commands: STATUS, RESET");
  printStatus(Serial);
}

void loop() {
  server.handleClient();

  if (SerialBT.available()) {
    String line = clean(SerialBT.readStringUntil('\n'));
    if (line.length() > 0) handlePhoneLine(line);
  }

  if (Serial.available()) {
    String line = clean(Serial.readStringUntil('\n'));
    handleSerialLine(line);
  }
}
