struct Student {
  String code;
  String name;
  bool present;
  String markedAt;
  String device;     // Bluetooth MAC of the phone that marked this student
};
std::vector<Student> students;

String sessionToken = "";

// ---------- remember which phone is connected ----------
char lastMac[18] = "";

#if DEVICE_LOCK
void btEvent(esp_spp_cb_event_t event, esp_spp_cb_param_t *param) {
  if (event == ESP_SPP_SRV_OPEN_EVT) {
    snprintf(lastMac, sizeof(lastMac), "%02X:%02X:%02X:%02X:%02X:%02X",
             param->srv_open.rem_bda[0], param->srv_open.rem_bda[1],
             param->srv_open.rem_bda[2], param->srv_open.rem_bda[3],
             param->srv_open.rem_bda[4], param->srv_open.rem_bda[5]);
  } else if (event == ESP_SPP_CLOSE_EVT) {
    lastMac[0] = 0;
  }
}
#endif

// ---------- helpers ----------
String clean(String s) {
  s.trim();
  s.toUpperCase();
  return s;
}

String cleanCode(String s) {
  s.trim();
  s.toUpperCase();
  String o = "";
  for (size_t i = 0; i < s.length() && o.length() < 16; i++) {
    char c = s[i];
    if (isalnum((unsigned char)c)) o += c;
  }
  return o;
}

String cleanName(String s) {
  s.trim();
  String o = "";
  for (size_t i = 0; i < s.length() && o.length() < 24; i++) {
    char c = s[i];
    if (c == '|' || c == '\n' || c == '\r' || c == '"' || c == '\\') continue;
    o += c;
  }
  return o;
}

int findByCode(const String& code) {
  for (size_t i = 0; i < students.size(); i++)
    if (students[i].code == code) return (int)i;
  return -1;
}

String nowText() {
  time_t t = time(nullptr);
  if (t > 1700000000) {
    struct tm tmv;
    localtime_r(&t, &tmv);
    char b[24];
    strftime(b, sizeof(b), "%Y-%m-%d %H:%M:%S", &tmv);
    return String(b);
  }
  return "uptime " + String(millis() / 1000) + "s";
}

// ---------- storage (survives power-off) ----------
void saveData() {
  String d = "";
  for (auto& s : students) {
    d += s.code + "|" + s.name + "|" + (s.present ? "1" : "0") + "|" + s.markedAt + "|" + s.device + "\n";
  }
  prefs.putString("data", d);
}

void loadData() {
  students.clear();
  String d = prefs.getString("data", "");
  if (d.length() == 0 && !prefs.isKey("data")) {
    // first run: default class list
    const char* codes[] = {"JOSHI", "JAYANTH", "INDRA", "IMRAN", "SHOAIB"};
    const char* names[] = {"Joshi", "Jayanth", "Indra", "Imran", "Shoaib"};
    for (int i = 0; i < 5; i++) students.push_back({codes[i], names[i], false, "", ""});
    saveData();
    return;
  }
  int start = 0;
  while (start < (int)d.length()) {
    int end = d.indexOf('\n', start);
    if (end < 0) end = d.length();
    String line = d.substring(start, end);
    start = end + 1;
    int p1 = line.indexOf('|');
    int p2 = line.indexOf('|', p1 + 1);
    int p3 = line.indexOf('|', p2 + 1);
    if (p1 < 0 || p2 < 0 || p3 < 0) continue;
    int p4 = line.indexOf('|', p3 + 1);
    Student s;
    s.code = line.substring(0, p1);
    s.name = line.substring(p1 + 1, p2);
    s.present = line.substring(p2 + 1, p3) == "1";
    if (p4 < 0) {
      s.markedAt = line.substring(p3 + 1);
      s.device = "";
    } else {
      s.markedAt = line.substring(p3 + 1, p4);
      s.device = line.substring(p4 + 1);
    }
    students.push_back(s);
  }
}

// ---------- serial status ----------
void printStatus(Stream& out) {
  out.println("\n========== Attendance ==========");
  for (auto& s : students) {
    out.printf("%-8s %-10s %s", s.code.c_str(), s.name.c_str(), s.present ? "PRESENT" : "ABSENT");
    if (s.present) out.printf("  (%s)", s.markedAt.c_str());
    out.println();
  }
  out.println("================================");
}

void resetAll() {
  for (auto& s : students) {
    s.present = false;
    s.markedAt = "";
    s.device = "";
  }
  saveData();
  Serial.println("Attendance reset. All students ABSENT.");
}

// ---------- Bluetooth (student side) ----------
void handlePhoneLine(const String& code) {
  if (code == "HELP") {
    SerialBT.println("Type your code, for example JOSHI, and press send.");
    return;
  }

  int idx = findByCode(code);
  if (idx < 0) {
    SerialBT.printf("Unknown code: %s\n", code.c_str());
    return;
  }

  if (students[idx].present) {
    SerialBT.printf("%s is already marked present.\n", students[idx].name.c_str());
    return;
  }

  String mac = String(lastMac);
#if DEVICE_LOCK
  if (mac.length() == 0) {
    SerialBT.println("Could not identify your phone. Disconnect, reconnect and try again.");
    return;
  }
  for (size_t i = 0; i < students.size(); i++) {
    if (students[i].present && students[i].device == mac) {
      SerialBT.printf("BLOCKED: this phone already marked %s present. One phone = one student.\n",
                      students[i].name.c_str());
      Serial.printf("BLOCKED: phone %s tried to mark %s (already used for %s)\n",
                    mac.c_str(), students[idx].name.c_str(), students[i].name.c_str());
      delay(1500);
      SerialBT.disconnect();
      while (SerialBT.available()) SerialBT.read();
      return;
    }
  }
#endif

  students[idx].present = true;
  students[idx].markedAt = nowText();
  students[idx].device = mac;
  saveData();
  Serial.printf("%s (%s) marked PRESENT\n", students[idx].name.c_str(), students[idx].code.c_str());

  SerialBT.printf("OK %s marked PRESENT\n", students[idx].name.c_str());
  SerialBT.println("Disconnecting. The next student can connect now.");
  delay(1500);
  SerialBT.disconnect();

  while (SerialBT.available()) SerialBT.read();
}

void handleSerialLine(const String& cmd) {
  if (cmd == "STATUS") printStatus(Serial);
  else if (cmd == "RESET") resetAll();
  else if (cmd.length() > 0) Serial.println("Commands: STATUS, RESET");
}

